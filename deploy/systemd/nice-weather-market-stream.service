[Unit]
Description=Nice Weather Polymarket top-of-book stream collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nice-weather
Group=nice-weather
WorkingDirectory=/opt/nice-weather/repo
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nice-weather/nice-weather.env
ExecStart=/opt/nice-weather/.venv/bin/nice-weather collect-market-stream --db /var/lib/nice-weather/nice-weather.sqlite3 --config /etc/nice-weather/nice-weather.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nice-weather

[Install]
WantedBy=multi-user.target
