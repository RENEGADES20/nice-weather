[Unit]
Description=KNYC native Live account (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nice-weather
Group=nice-weather
WorkingDirectory=/opt/nice-weather/knyc-current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/nice-weather/knyc-live-%i.env
ExecStart=/opt/nice-weather/knyc-current/.venv/bin/python -m nice_weather.trading.us_live --root /var/lib/nice-weather-knyc --venue %i --credentials ${NICE_WEATHER_LIVE_CREDENTIALS} --balance-precision ${NICE_WEATHER_BALANCE_PRECISION}
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nice-weather-knyc

[Install]
WantedBy=multi-user.target
