[Unit]
Description=Nice Weather KLGA shadow runner
After=network-online.target nice-weather-collector.service
Wants=network-online.target

[Service]
Type=simple
User=nice-weather
Group=nice-weather
WorkingDirectory=/opt/nice-weather/repo
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nice-weather/nice-weather.env
ExecStart=/opt/nice-weather/.venv/bin/nice-weather run-loop --mode shadow --city NYC --interval-seconds 60 --config /etc/nice-weather/nice-weather.toml --db /var/lib/nice-weather/nice-weather.sqlite3
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nice-weather

[Install]
WantedBy=multi-user.target
