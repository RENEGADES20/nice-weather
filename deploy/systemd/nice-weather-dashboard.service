[Unit]
Description=Nice Weather read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nice-weather
Group=nice-weather
WorkingDirectory=/opt/nice-weather/repo
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nice-weather/nice-weather.env
ExecStart=/opt/nice-weather/.venv/bin/streamlit run /opt/nice-weather/repo/src/nice_weather/dashboard.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true -- --db /var/lib/nice-weather/nice-weather.sqlite3 --refresh-seconds 10
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/nice-weather

[Install]
WantedBy=multi-user.target
