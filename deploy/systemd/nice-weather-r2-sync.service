[Unit]
Description=Nice Weather upload pending KLGA captures to Cloudflare R2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nice-weather
Group=nice-weather
WorkingDirectory=/opt/nice-weather
EnvironmentFile=/etc/nice-weather/r2.env
ExecStart=/opt/nice-weather/.venv/bin/nice-weather r2-sync --db /var/lib/nice-weather/weather.sqlite3 --config /etc/nice-weather/collector.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nice-weather
